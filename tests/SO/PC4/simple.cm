int main(void) {
    int pos;
    int color;
    int delay;
    int aux;

    pos = 0;
    color = 1;

    while (1) {
        draw_pixel(pos, color);

        delay = 0;
        while (delay < 300) {
            delay = delay + 1;
        }

        pos = pos + 1;

        if (pos >= 1200) {
            pos = 0;
            color = color + 1;

            if (color >= 8) {
                color = 1;
            }
        }
    }

    return 0;
}
