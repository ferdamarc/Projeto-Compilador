/* Programa para mostrar o menor elemento de um vetor */

int vet[5];

int menor(int a[], int n){
    int i; int m;
    m = a[0];
    i = 1;
    while(i < n){
        if(a[i] < m){
            m = a[i];
        }
        i = i + 1;
    }
    return m;
}

int main(void){
    int i; int m;

    i = 0;
    /*
    while(i < 5){
        vet[i] = input();
        i = i + 1;
    }
    */
    vet[0] = 5;
    vet[1] = 3;
    vet[2] = 8;
    vet[3] = 1;
    vet[4] = 4;
    m = menor(vet,5);
    output(m);

    return 0;
}