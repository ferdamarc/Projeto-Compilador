/* Parametros de resolucao VGA reduzida (640x480 / 16) */
int VGA_WIDTH;
int VGA_HEIGHT;

int COLOR_BG;
int COLOR_CURSOR;

int KEY_UP;
int KEY_DOWN;

/* Funcao auxiliar para calcular o indice do framebuffer e desenhar o pixel */
void drawpixelVGA(int x, int y, int color) {
    int framebufferindex;

    /* Verificacao de limites da tela para evitar falhas de segmentacao/memoria */
    if (x < 0) {
        return;
    }
    if (x >= VGA_WIDTH) {
        return;
    }
    if (y < 0) {
        return;
    }
    if (y >= VGA_HEIGHT) {
        return;
    }

    framebufferindex = y * VGA_WIDTH + x;
    draw_pixel(framebufferindex, color);
}

/* Preenche toda a tela com uma cor especifica */
void clearScreen(int color) {
    int i;
    int j;
    
    i = 0;
    while (i < VGA_HEIGHT) {
        j = 0;
        while (j < VGA_WIDTH) {
            drawpixelVGA(j, i, color);
            j = j + 1;
        }
        i = i + 1;
    }
}

/* Desenha um quadrado de um tamanho especifico na posicao (x,y) */
void drawSquare(int x, int y, int size, int color) {
    int i;
    int j;
    int endy;
    int endx;

    endy = y + size;
    endx = x + size;

    i = y;
    while (i < endy) {
        j = x;
        while (j < endx) {
            drawpixelVGA(j, i, color);
            j = j + 1;
        }
        i = i + 1;
    }
}

int main(void) {
    int keypressed;
    int cursorX;
    int cursorY;
    int oldCursorY;
    int CURSOR_SIZE;

    /* Inicializacao das variaveis globais */
    VGA_WIDTH = 40;  
    VGA_HEIGHT = 30; 

    COLOR_BG = 0;    /* Cor de fundo */
    COLOR_CURSOR = 7; /* Cor do cursor */
    CURSOR_SIZE = 2; /* Tamanho do bloco */

    KEY_UP = 29;     /* Scancode da tecla W */
    KEY_DOWN = 27;   /* Scancode da tecla S */

    /* Posiciona o cursor no centro da tela inicialmente */
    cursorX = VGA_WIDTH / 2;
    cursorY = VGA_HEIGHT / 2;
    oldCursorY = cursorY;

    /* Teste 1: Preenche o framebuffer inteiro com a cor de fundo */
    clearScreen(COLOR_BG);

    /* Teste 2: Desenha o bloco inicial no centro da tela */
    drawSquare(cursorX, cursorY, CURSOR_SIZE, COLOR_CURSOR);

    /* Loop principal (Polling do Teclado) */
    while (1) {
        keypressed = keyboard_input();

        /* Processa apenas se alguma tecla foi pressionada */
        if (keypressed != 0) {
            oldCursorY = cursorY;

            /* Logica de movimento: Cima */
            if (keypressed == KEY_UP) {
                if (cursorY > 0) {
                    cursorY = cursorY - 1;
                }
            } 
            else {
                /* Logica de movimento: Baixo */
                if (keypressed == KEY_DOWN) {
                    if ((cursorY + CURSOR_SIZE) < VGA_HEIGHT) {
                        cursorY = cursorY + 1;
                    }
                }
            }

            /* Se a posicao do cursor mudou, atualiza a interface VGA */
            if (oldCursorY != cursorY) {
                /* Apaga a posicao antiga sobrescrevendo com a cor de fundo */
                drawSquare(cursorX, oldCursorY, CURSOR_SIZE, COLOR_BG);
                
                /* Desenha o cursor na nova posicao */
                drawSquare(cursorX, cursorY, CURSOR_SIZE, COLOR_CURSOR);
            }
        }
    }

    return 0;
}